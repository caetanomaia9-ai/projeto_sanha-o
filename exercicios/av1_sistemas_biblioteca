print("=================================")
print("     SISTEMA PARA BIBLIOTECA")
print("=================================")

repeticoes = int(input("Quantas operações deseja realizar? "))

for i in range(repeticoes):

    print()
    print("=================================")
    print("1 - Cadastrar Livros")
    print("2 - Cadastrar Alunos")
    print("3 - Realizar Empréstimo")
    print("4 - Sair")
    print("=================================")

    opcao = input("Escolha uma opção: ")

    if opcao == "1":
        print()
        print("----- CADASTRO DE LIVROS -----")

        quantidade_livros = int(input("Quantos livros deseja cadastrar? "))

        for i in range(quantidade_livros):
            print()
            print("----- LIVRO", i + 1, "----")

            codigo = input("Código do livro: ")

            titulo = input("Título do livro: ")

            if titulo == "":
                print("Erro: o título não pode ficar vazio.")
            else:
                autor = input("Nome do autor: ")

                if autor == "":
                    print("Erro: o autor não pode ficar vazio.")
                else:
                    ano = int(input("Ano de publicação: "))

                    if ano <= 0:
                        print("Erro: ano de publicação inválido.")
                    else:
                        quantidade = int(input("Quantidade disponível: "))

                        if quantidade <= 0:
                            print("Erro: a quantidade deve ser maior que zero.")
                        else:
                            print("Livro cadastrado com sucesso!")

    elif opcao == "2":
        print()
        print("----- CADASTRO DE ALUNOS -----")

        quantidade_alunos = int(input("Quantos alunos deseja cadastrar? "))

        for i in range(quantidade_alunos):
            print()
            print("----- ALUNO", i + 1, "----")

            matricula = input("Matrícula: ")

            if matricula == "":
                print("Erro: a matrícula não pode ficar vazia.")
            else:
                nome = input("Nome do aluno: ")

                if nome == "":
                    print("Erro: o nome não pode ficar vazio.")
                else:
                    turma = input("Turma: ")

                    if turma == "":
                        print("Erro: a turma não pode ficar vazia.")
                    else:
                        print("Aluno cadastrado com sucesso!")

    elif opcao == "3":
        print()
        print("----- EMPRÉSTIMO -----")

        codigo_livro = input("Código do livro: ")

        if codigo_livro == "":
            print("Erro: o código do livro não pode ficar vazio.")
        else:
            matricula_aluno = input("Matrícula do aluno: ")

            if matricula_aluno == "":
                print("Erro: a matrícula não pode ficar vazia.")
            else:
                quantidade_disponivel = int(
                    input("Quantidade disponível: ")
                )

                if quantidade_disponivel > 0:
                    print("Empréstimo realizado com sucesso!")
                else:
                    print("Não é possível realizar o empréstimo.")
                    print("Não há exemplares disponíveis.")

    elif opcao == "4":
        print()
        print("Sistema encerrado.")
        break

    else:
        print()
        print("Opção inválida.")

